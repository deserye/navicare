# Copy this file to .streamlit/secrets.toml for local runs.
# On Streamlit Community Cloud, paste the same keys into Settings → Secrets.
# Never commit the real secrets file.

OPENAI_API_KEY = "your-secret-key"
CARE_LLM_MODEL = "gpt-4o-mini"

# Leave APP_PASSWORD unset (or delete the line) for a public app.
# Set it only when you want a simple password gate.
# APP_PASSWORD = "choose-a-private-password"

# Optional. Set OPENAI_API_BASE only when you use an OpenAI-compatible endpoint.
